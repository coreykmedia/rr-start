---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Redefining Retirement — Start Here",
  "url": "https://start.redefiningretirement.io",
  "description": "Tools, guides, comparisons, and newsletter resources for Gen X creators building audience-owned income.",
  "publisher": {
    "@type": "Organization",
    "name": "Redefining Retirement",
    "url": "https://redefiningretirement.io"
  }
};

const pathways = [
  {
    label: "What's Your Audience Worth?",
    desc: 'A free calculator that shows you what your following could actually be worth as an email list — and what you might be sitting on without realizing it.',
    href: '/tools/whats-your-audience-worth',
    image: '/tools/audience-worth-hero.jpg',
  },
  {
    label: 'Solopreneur Tools',
    desc: 'The software stack that actually matters — newsletter platforms, podcast gear, AI tools, and more.',
    href: 'https://redefiningretirement.io/c/solopreneur-business-resources-tools-courses?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    image: '/images/resources/solopreneur-tools.jpg',
  },
  {
    label: 'AI Newsletter Fast Track',
    desc: 'A step-by-step guide to using AI to build and grow a newsletter faster than going it alone.',
    href: 'https://redefiningretirement.io/p/ai-newsletter-fast-track-step-by-step-guide?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    image: '/images/resources/ai-newsletter-fast-track.jpg',
  },
  {
    label: 'Gen Exit Playbook',
    desc: 'Free strategy guide for Gen X — how to build income and independence before you have to retire.',
    href: 'https://redefiningretirement.io/c/gen-exit-playbook?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    image: '/images/resources/gen-exit-playbook-cover.jpg',
  },
];

const featured = [
  {
    tag: 'Comparison',
    title: 'Beehiiv vs. Substack: An Honest Breakdown',
    desc: 'The real differences in pricing, monetization, and who each platform is actually built for — without the affiliate spin.',
    href: 'https://redefiningretirement.io/p/beehiiv-vs-substack-newsletter-platform-comparison?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    cta: 'Read the comparison &rarr;',
    image: '/images/resources/beehiiv-vs-substack.jpg',
  },
  {
    tag: 'Guide',
    title: 'LinkedIn Newsletter vs. Email Newsletter',
    desc: 'You don\'t own your LinkedIn audience. Here\'s what that actually means — and what to do about it.',
    href: 'https://redefiningretirement.io/p/linkedin-newsletter-vs-email-newsletter?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    cta: 'Read the guide &rarr;',
    image: '/images/resources/linkedin-vs-email-newsletter.png',
  },
  {
    tag: 'Guide',
    title: 'How to Monetize a Newsletter in 2025',
    desc: 'Six income streams Gen X creators are using to turn an email list into real recurring revenue.',
    href: 'https://redefiningretirement.io/p/how-to-monetize-a-newsletter-2025-gen-x-creators-income-guide?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    cta: 'Read the guide &rarr;',
    image: '/images/resources/newsletter-monetization.jpg',
  },
  {
    tag: 'Guide',
    title: 'What Is a Blogletter? A Beginner\'s Guide',
    desc: 'Blog or newsletter? Turns out the answer might be both — what a "blogletter" is and why it might be the simpler model.',
    href: 'https://redefiningretirement.io/p/what-is-a-blogletter-a-complete-guide-for-beginners?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    cta: 'Read the guide &rarr;',
    image: '/images/resources/blogletter-guide.jpg',
  },
  {
    tag: 'AI',
    title: 'The Quiet AI Side Hustle for Gen X',
    desc: 'No coding, no main-character energy required — a low-key way to put AI to work without performing for an audience.',
    href: 'https://redefiningretirement.io/p/quiet-ai-side-hustle-gen-x?utm_source=start-here&utm_medium=referral&utm_campaign=start-page',
    cta: 'Read the guide &rarr;',
    image: '/images/resources/quiet-ai-side-hustle.jpg',
  },
];
---

<Layout
  title="Start Here | Redefining Retirement"
  description="Tools, guides, and resources for Gen X creators building work they never want to retire from. The best place to start."
  schema={schema}
>

  <!-- SECTION 1: Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-photo">
        <img
          src="/images/corey-portrait.jpg"
          alt="Corey Koehler — Redefining Retirement"
          class="portrait"
        />
      </div>
      <div class="hero-content">
        <p class="section-heading">Start Here</p>
        <h1>Too Young to Retire, Too Old to Take Orders? Me Too.</h1>
        <p class="hero-sub">
          I'm Corey. Blue-collar kid, Class of '90, singer-songwriter, accidental entrepreneur.
          I've reinvented myself more times than I can count and I'm still going.
          This is where I share how I'm looking for ways to get paid on my own terms.
        </p>
        <div class="hero-ctas">
          <a href="https://redefiningretirement.io/subscribe" class="btn" target="_blank" rel="noopener noreferrer">
            Join the newsletter — free
          </a>
          <a href="/resources/" class="btn btn--outline">Browse the resources</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: Philosophy / About -->
  <section class="section about-section">
    <div class="container">
      <div class="about-inner">
        <p class="section-heading">How I think about this</p>
        <h2 class="about-heading">It's not about whether you want to retire — or even can right now. It's about looking for ways to get paid on your own terms and making a change you can actually live with for the rest of your life. All while trying to have some fun and not take things so damn seriously along the way.</h2>
        <div class="about-body">
          <p class="about-lead">
            I grew up a latchkey kid in the 80s. Nobody was managing my afternoon. That kind of
            independence gets into your blood.
          </p>

          <p>
            Redefining Retirement isn't really about 401(k)s, IRAs, or counting down to a golf
            cart. Maybe you got laid off or downsized. Or maybe you're just sick of the BS and
            looking for something different — like I was back in 2013. Either way, here's the
            thing: if you're going to make a change anyway, you might as well work toward stuff
            you actually love, that also supports the life you want now and down the road.
          </p>
          <p>
            <strong>There's that old saying — if you love what you do, you'll never work a day in your
            life.</strong>
          </p>
          <p>
            I've reinvented myself multiple times, from foundry worker to mechanical draftsman.
            When I needed out the last time, I told myself: if I'm doing this again, I'm working
            on stuff I actually want to do. Stuff that could eventually support a retirement. So
            yeah, I do want to retire someday — but in the meantime, why not look for ways to
            get paid on my own terms and build toward things I actually like doing?
          </p>
          <p>
            That's been the last 10-15 years. Finding stuff I like learning about and working on,
            that's marketable, that supports the life I want, with people I like working with —
            then letting the rest sort itself out. The goal was never really retirement. It's
            getting to where, retired or not, I already feel like I am — because I like the stuff
            I do enough to do it anyway, on my own terms, whenever and wherever I want.
          </p>

          <p class="about-closer">
            I'm endlessly curious — I like to tinker, reminisce, philosophize, and geek out about
            this stuff with other people. That's what this newsletter, blog, and channel is
            about: a diary of the things I'm working on and philosophizing about, trying to have
            some fun and not take it all too seriously along the way.
          </p>
        </div>
        <div class="about-byline">
          <img src="/images/corey-portrait.jpg" alt="Corey Koehler" class="byline-photo" />
          <span class="byline-name">Corey Koehler</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: What I'm Tinkering With -->
  <section class="section tinkering-section">
    <div class="container">
      <p class="section-heading">On the workbench</p>
      <h2 class="section-title">What I'm Tinkering With Right Now</h2>
      <div class="prose">
        <p>
          I'm something of an AI crash test dummy — I try the stuff so you don't have to crash
          into it yourself. Here's what's currently on the workbench:
        </p>
        <ul>
          <li>
            <strong>Learning to run my business (or businesses) from one terminal</strong> — I
            got into Claude Code hoping I could manage my entire business — maybe even multiple
            businesses — from a single tool. Not there yet, but getting closer every day.
          </li>
          <li>
            <strong>Migrated my Google Ads business website, CoreyKoehlerMedia.com, from WordPress
            to Astro</strong> — so I could manage and edit it directly through Claude Code instead
            of wrestling with WordPress. A lot of trial and error, but once it's working, it's
            pretty slick and pretty easy to manage.
          </li>
          <li>
            <strong>Building a simple tool that tells creators what their email list is actually
            worth</strong> — <a href="/tools/whats-your-audience-worth">try the early version &rarr;</a>.
            I keep seeing people with massive audiences on platforms that could vanish or change
            the rules overnight, with no way to reach those people if it happens. Built a version
            of this before, didn't push it hard enough, giving it another shot.
          </li>
          <li>
            <strong>Starting up the podcast and YouTube channel again</strong> — refining the
            direction a little, I think it was too serious and I want to lighten it up a bit. Plus
            figuring out how to cut the editing and distribution time down so it doesn't eat my
            whole week.
          </li>
        </ul>
        <p>
          If any of this turns into something useful, you'll hear about it here first — usually
          with a story about everything that went wrong along the way.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: Start Here Pathways -->
  <section class="section pathways-section">
    <div class="container">
      <p class="section-heading">Where do you want to start?</p>
      <h2 class="section-title">Start Here</h2>
      <div class="pathways-grid">
        {pathways.map(({ label, desc, href, image }) => (
          <a
            href={href}
            class="pathway-card"
            target={href.startsWith('/') ? undefined : '_blank'}
            rel={href.startsWith('/') ? undefined : 'noopener noreferrer'}
          >
            <img src={image} alt={label} class="pathway-card-img" />
            <div class="pathway-card-body">
              <h3>{label}</h3>
              <p>{desc}</p>
              <span class="pathway-cta">Explore &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: Featured Resources -->
  <section class="section featured-section">
    <div class="container">
      <p class="section-heading">Useful things</p>
      <h2 class="section-title">Resources Worth Checking Out</h2>
      <p class="section-desc">Comparison guides, frameworks, and practical tools — picked for clarity, not clicks.</p>
      <div class="card-grid card-grid--3">
        {featured.map(({ tag, title, desc, href, cta, image }) => (
          <a href={href} class="card card--link" target="_blank" rel="noopener noreferrer">
            <img src={image} alt={title} class="card-img" />
            <div class="card-body">
              <span class="tag">{tag}</span>
              <h3>{title}</h3>
              <p>{desc}</p>
              <span class="card-link" set:html={cta} />
            </div>
          </a>
        ))}
      </div>
      <p class="section-footer-link"><a href="/resources/">See all guides &rarr;</a></p>
    </div>
  </section>

  <!-- SECTION 6: Bridge to Main Site -->
  <section class="section bridge-section">
    <div class="container">
      <div class="cta-block">
        <p class="section-heading">The full picture</p>
        <h2>More on RedefiningRetirement.io</h2>
        <p>
          This site is the resource hub — guides, comparisons, and tools you can browse and bookmark.
          The newsletter and main editorial home lives at RedefiningRetirement.io. That's where I
          publish deeper thinking, reader questions, and the ongoing conversation about what
          retirement can actually look like for people like us. If this is your first visit,
          that's the best place to go next.
        </p>
        <a
          href="https://redefiningretirement.io"
          class="btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit RedefiningRetirement.io &rarr;
        </a>
        <p class="cta-footnote">Free newsletter. No pitch. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-photo {
    flex-shrink: 0;
  }

  .portrait {
    width: 100%;
    max-width: 280px;
    border-radius: var(--radius);
    object-fit: cover;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--border);
  }

  .hero-content h1 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
    margin-bottom: 1rem;
    margin-top: 0.5rem;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.75rem;
    max-width: 520px;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

/* ── About ── */
  .about-section {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .about-inner {
    max-width: 680px;
  }

  .about-heading {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    margin-bottom: 1.5rem;
    margin-top: 0.5rem;
    line-height: 1.3;
  }

  .about-body p {
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  .about-lead {
    font-size: 1.1rem;
    color: var(--text);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .about-closer {
    font-size: 1.05rem;
    color: var(--text);
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .about-byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .byline-photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .byline-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  /* ── Section titles ── */
  .section-title {
    margin-bottom: 0.5rem;
    margin-top: 0.25rem;
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
    max-width: 540px;
  }

  .section-footer-link {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  /* ── Pathways ── */
  .pathways-section {
    border-bottom: 1px solid var(--border);
  }

  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin-top: 1.5rem;
  }

  .pathway-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .pathway-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    border-color: var(--blue);
    text-decoration: none;
  }

  .pathway-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .pathway-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem 1.5rem;
    flex: 1;
  }

  .pathway-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .pathway-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }

  .pathway-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--blue);
    margin-top: 0.5rem;
  }

  /* ── Featured ── */
  .featured-section {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .card--link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue);
  }

  .card-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* ── Bridge ── */
  .bridge-section {
    background: var(--body-bg);
  }

  .cta-footnote {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-light);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .portrait {
      max-width: 180px;
    }

    .hero-photo {
      display: flex;
      justify-content: center;
    }

    .hero-content {
      text-align: center;
    }

    .hero-sub {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas {
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }

    .hero-ctas .btn {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 0 2rem;
    }

    .pathways-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 420px) {
    .pathways-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
