    font-family:'Caveat',cursive; color:var(--gej-accent); font-weight:700; font-size:19px; min-width:30px;
  }
  .toc a .dots{ flex:1; border-bottom:1px dotted var(--line); margin:0 4px 4px; }
  .toc a:hover{ color:var(--gej-accent); }

