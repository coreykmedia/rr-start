---
import Layout from '../../../../layouts/Layout.astro';

const KIT_URL = 'https://start.redefiningretirement.io/products/newsletter-ai-fast-track-kit/kit';
const PRODUCT_PRICE = 27;
---

<Layout
  title="Thank You | Redefining Retirement"
  description="Your Newsletter AI Fast-Track Kit purchase is confirmed."
  type="website"
  noindex={true}
  bare={true}
>
  <section class="section">
    <div class="container ty-container">
      <p class="ty-eyebrow">Purchase Confirmed</p>
      <h1 class="ty-headline">You're in — your <strong>Newsletter AI Fast-Track Kit</strong> is confirmed.</h1>
      <p class="ty-subhead">Click below to start your Kit — the fill-in-the-blank prompts, exact scripts, and videos are ready for you.</p>
      <a class="btn btn-cta" href={KIT_URL}>Start My Kit &rarr;</a>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ PRODUCT_PRICE }}>
  (function () {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'purchase',
      ecommerce: {
        transaction_id: 'kit-' + Date.now(),
        currency: 'USD',
        value: PRODUCT_PRICE,
        items: [{ item_id: 'newsletter-ai-fast-track-kit', item_name: 'The Newsletter AI Fast-Track Kit', price: PRODUCT_PRICE, quantity: 1 }],
      },
    });
  })();
</script>

<style>
  .ty-container {
    max-width: 720px;
    text-align: center;
  }

  .ty-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .ty-headline {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin-bottom: 0.75rem;
  }

  .ty-subhead {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .btn-cta {
    height: 56px;
    padding: 0 2rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
</style>
