<script is:inline>
  /* ── progress bar ── */
  var bar = document.getElementById('progress');
  window.addEventListener('scroll', function () {
    var h = document.documentElement;
    bar.style.width = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100 + '%';
  });

  /* ── delivered date ── */
  (function () {
    var d = new Date();
    var months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    var stamp = months[d.getMonth()] + " " + d.getFullYear();
    var el = document.getElementById('delivered-date');
    if (el) el.textContent = "Delivered " + stamp;
    var ns = document.getElementById('ns-date');
    if (ns) ns.textContent = stamp;
  })();

  /* ── fill-once engine: inputs -> placeholders, persisted to localStorage ── */
  (function () {
    var KEY = 'gen-exit-compass-v1';
    var DEFAULTS = {
      age: '[your age]',
      roles: '[your past jobs and roles]',
      skills: '[your skills]',
      tools: '[software and tools you know]',
      projects: '[projects that made or saved money]',
      hobbies: '[your hobbies and interests]',
      direction: '[your job title, career goal, or business idea]',
      jobsFound: '[list them]',
      servicesFound: '[list them]',
      ratesFound: '[list them]'
    };
    var store = {};
    try { store = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) {}

    var fields = Array.prototype.slice.call(document.querySelectorAll('[data-field]'));
    var savedFlag = document.getElementById('wb-saved');

    function applyField(name) {
      var val = (store[name] && String(store[name]).trim()) ? String(store[name]).trim() : DEFAULTS[name];
      var spans = document.querySelectorAll('.ph[data-ph="' + name + '"]');
      Array.prototype.forEach.call(spans, function (el) { el.textContent = val; });
    }

    fields.forEach(function (input) {
      var name = input.getAttribute('data-field');
      if (store[name] !== undefined) { input.value = store[name]; }
      applyField(name);
      input.addEventListener('input', function () {
        store[name] = input.value;
        try { localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) {}
        applyField(name);
        if (savedFlag) {
          savedFlag.classList.add('show');
          clearTimeout(savedFlag._t);
          savedFlag._t = setTimeout(function () { savedFlag.classList.remove('show'); }, 1200);
        }
      });
    });
  })();

  /* ── North Star: persist + copy ── */
  (function () {
    var KEY = 'gen-exit-compass-northstar-v1';
    var store = {};
    try { store = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) {}
    var fields = Array.prototype.slice.call(document.querySelectorAll('[data-ns]'));
    fields.forEach(function (input) {
      var name = input.getAttribute('data-ns');
      if (store[name] !== undefined) input.value = store[name];
      input.addEventListener('input', function () {
        store[name] = input.value;
        try { localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) {}
      });
    });

    var copyBtn = document.getElementById('ns-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var v = function (id) { var el = document.getElementById(id); return el && el.value.trim() ? el.value.trim() : '—'; };
        var text =
          "MY NORTH STAR\n\n" +
          "My direction is: " + v('ns-direction') + "\n\n" +
          "It's AI-proof because: " + v('ns-aiproof') + "\n\n" +
          "I'd do it anyway because: " + v('ns-anyway') + "\n\n" +
          "My #1 opportunity is: " + v('ns-opp') + "\n\n" +
          "My first move this week is: " + v('ns-move') + "\n\n" +
          "— via The Gen eXit Compass · RedefiningRetirement.io";
        var done = function () {
          var orig = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          copyBtn.classList.add('copied');
          setTimeout(function () { copyBtn.textContent = orig; copyBtn.classList.remove('copied'); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text; document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta); done();
        }
      });
    }
  })();

  /* ── copy buttons for prompts ── */
  (function () {
    var copyBtns = Array.prototype.slice.call(document.querySelectorAll('[data-copy]'));
    copyBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var wrap = btn.closest('.ai-prompt');
        var textEl = wrap ? wrap.querySelector('.ap-text') : null;
        if (!textEl) return;
        var text = (textEl.innerText || textEl.textContent).trim();
        var done = function () {
          var orig = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(function () { btn.textContent = orig; btn.classList.remove('copied'); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text; document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta); done();
        }
      });
    });
  })();
</script>

